def cmd_rotate(args):
    """Swap weak slots onto top-ranked pairs from the screen cache.

    A slot is "weak" when its current pair is not in the top-N ranked
    screen list. Proposes swaps, then (with --yes) stops the affected
    engines, rematerializes them onto the best unheld ranked pairs, writes
    the override to state/slots.json, and restarts the fleet. Dry-run only:
    the instances trade paper, never live.

    --llm: filter every candidate through the LLM swarm (Mistral-driven
           deliberation, ported as grid.agents.deliberate). NO_GO tickets
           are dropped from the swap list with a printed rationale;
           llm_degraded tickets pass through (rule-fallback) so an LLM
           outage never blocks the loop."""
    top = _arg_int(args, "--top", len(SLOTS))
    yes = "--yes" in args
    use_llm = "--llm" in args
    cache = STATE / "screen_cache.json"
    if not cache.is_file():
        sys.exit("no screen cache — run: grid/dev screen first")
    try:
        ranked = (json.loads(cache.read_text()) or {}).get("pairs") or []
    except Exception:
        sys.exit("screen cache unreadable — re-run: grid/dev screen")
    ranked = [p for p in ranked
              if isinstance(p, dict) and p.get("pair") and p.get("pair_code")][:top]
    if not ranked:
        sys.exit("screen cache empty — re-run: grid/dev screen")

    slots = effective_slots()
    score_of = {p["pair"]: p.get("score", 0.0) for p in ranked}
    weak = [code for code, (pair, _c) in slots.items() if pair not in score_of]
    if not weak:
        print("no weak slots — every slot's pair is already top-ranked")
        return

    held = {pair for pair, _c in slots.values()}
    available = [p for p in ranked if p["pair"] not in held]
    over, swaps, skipped = {}, [], []
    for code in weak:
        if not available:
            print(f"no unheld ranked pairs left to swap into {code}")
            break
        pick = available.pop(0)
        if use_llm:
            ticket = _swarm_ticket(pick, current_pair=slots[code][0])
            verdict = ticket.get("decision", "NO_GO")
            if verdict != "GO":
                skipped.append((code, slots[code][0], pick["pair"],
                                ticket.get("veto") or ticket.get(
                                    "rationale", ""), ticket.get(
                                    "llm_degraded", False)))
                continue
        over[code] = [pick["pair"], pick["pair_code"]]
        swaps.append((code, slots[code][0], pick["pair"]))

    print(f"proposed swaps ({len(swaps)}):")
    for code, old, new in swaps:
        print(f"  {code}: {old} -> {new}")
    if skipped:
        print(f"skipped by swarm ({len(skipped)}):")
        for code, old, new, why, degraded in skipped:
            tag = " [degraded]" if degraded else ""
            print(f"  {code}: {old} -> {new}  ({why}){tag}")
    if not swaps:
        print("nothing to swap — every candidate vetoed (or no candidates)")
        return
    if not yes:
        print("re-run with --yes to apply (stops affected engines, "
              "rematerializes, writes state/slots.json, restarts)")
        return

    reg = load_registry()
    for code, _old, _new in swaps:
        entry = reg["instances"].get(code)
        if isinstance(entry, dict):
            running, pid = engine_running(entry)
            if running:
                print(f"engine {code} stopping (pid {pid})")
                _terminate(pid)
                entry["pid"] = None
                entry["status"] = "stopped"
                _pidfile_clear(code)
    save_registry(reg)

    merged = dict(SLOTS)
    try:
        prev = json.loads(SLOTS_OVERRIDE.read_text())
        if isinstance(prev, dict):
            merged.update({k: v for k, v in prev.items()
                           if isinstance(v, list) and len(v) == 2})
    except Exception:
        pass
    for code in over:
        merged[code] = over[code]
    SLOTS_OVERRIDE.parent.mkdir(parents=True, exist_ok=True)
    SLOTS_OVERRIDE.write_text(json.dumps(
        {k: v for k, v in merged.items() if tuple(v) != SLOTS.get(k)},
        indent=2) + "\n")

    for code, _old, new in swaps:
        materialize(code)
        print(f"engine {code} rematerialized on {new}")
    engine_start()
    print(f"rotate done — {len(swaps)} slot(s) swapped; override at "
          f"{SLOTS_OVERRIDE}")


def _swarm_ticket(screen_row, current_pair=""):
    """Run the LLM swarm (Mistral-driven deliberation) on one screen row.

    Builds the brief from the screen cache + the live reliability ledger
    bucket for the candidate's regime/archetype (so the swarm sees past
    outcomes), calls grid.agents.deliberate, and returns the ticket dict.
    Never raises — on total failure returns a rule-fallback NO_GO so a
    broken swarm can't approve a swap.

    The score_final feed into the brief uses screen_row['score'] scaled to
    ~0–100 to match the regime gate (rule-fallback facilitator uses
    score_final > 45 = GO; the live LLM also benefits from the same
    framing). ATR%/volume come from the screen row.
    """
    try:
        sys.path.insert(0, str(WS))
        from grid.agents import deliberate as _deliberate
    except Exception as exc:
        return {"decision": "NO_GO", "veto": f"agents unavailable: {exc}",
                "llm_degraded": True}

    coin = screen_row.get("coin") or screen_row.get("pair", "").split("/")[0]
    pair = screen_row.get("pair", "")
    atr = screen_row.get("atr_pct") or 0.0
    vol = screen_row.get("dayNtlVlm") or 0.0
    score = screen_row.get("score") or 0.0
    # regime heuristic: ATR% > 2.5 + not extreme vol → trend_up (long grid)
    # ATR% in [0.8, 2.5] → chop (neutral); ATR% < 0.8 → skip-grade flat
    regime = ("trend_up" if atr >= 2.5 else
              "chop_high_volatility" if atr >= 0.8 else "neutral")

    # pull the live ledger bucket (size + PF) so the swarm sees evidence
    evidence = {}
    try:
        from grid.reliability import ledger as _m4
        led = (json.loads(RELIABILITY.read_text())
               if RELIABILITY.is_file() else {})
        key = _m4.ledger_key(LADDER_ARCHETYPE)
        st = led.get(key) if isinstance(led, dict) else None
        if isinstance(st, dict):
            evidence = {"samples": st.get("samples"),
                        "profit_factor": st.get("profit_factor"),
                        "recent_pf": st.get("recent_pf")}
    except Exception:
        pass

    brief = {
        "symbol": coin, "tv_symbol": f"BINANCE:{coin}USDT",
        "venue": "hyperliquid", "regime": regime,
        # score_final is the unitless 0–100 score the facilitator gate
        # expects. Volume×ATR is in the 10^9 range; rescale to ≈ 0–100
        # by dividing by 1e8 and clamping, so the LLM and the
        # rule-fallback agree on a sensible gate.
        "score_final": max(0.0, min(100.0, score / 1e8)),
        "step": round(atr, 4),
        "spread_pct": 0.02,
        "metrics": {"price": 0.0, "atr_pct": atr, "adx14": 20.0,
                    "rsi14": 50.0, "bb_width_pctile": 50.0},
        "confluence_notes": ([f"score={score:.0f}", f"vol=${vol:.0f}",
                              f"atr={atr}%"]),
        "evidence": evidence,
        "stagnation_policy": {"min_hold_h": 24},
        "slot": {"slot": 0, "balance": DRY_RUN_WALLET,
                 "max_commitment": DRY_RUN_WALLET * 0.5,
                 "current_pair": current_pair},
    }
    try:
        # 2026-09-15 reset: every swarm decision is grounded in the
        # lower-TF band the engines now trade on. attach_multi_tf fetches
        # 1m + 5m + 15m candles from Hyperliquid and threads the summary
        # into brief['market_context'] so every agent sees the same
        # structure + execution view. Best-effort: HL outage still
        # returns a metrics-only brief.
        from grid.agents import attach_multi_tf as _attach_mtf
        brief = _attach_mtf(brief, coin=coin)
    except Exception:
        pass
    try:
        return _deliberate(brief)
    except Exception as exc:
        return {"decision": "NO_GO", "veto": f"deliberate raised: {exc}",
                "llm_degraded": True}


def cmd_evaluate(args):
    """Run the LLM swarm on a single symbol (no state mutation).

    Usage:
      grid/dev evaluate BTC        # by coin symbol (uses screen cache)
      grid/dev evaluate BTC --from-row 3
                                  # pick the Nth-ranked row from the cache
    Prints the full ticket (decision, grid_type, rationale, risk notes,
    llm_degraded, facilitator provider). Never applies anything; use
    `rotate --llm --yes` to act on the swarm's verdict.
    """
    if not args:
        sys.exit("usage: grid/dev evaluate <SYMBOL> [--from-row N]")
    symbol = args[0].upper()
    from_row = None
    if "--from-row" in args:
        try:
            from_row = int(args[args.index("--from-row") + 1])
        except (ValueError, IndexError):
            sys.exit("--from-row needs an integer argument")

    cache = STATE / "screen_cache.json"
    row = None
    if cache.is_file():
        try:
            ranked = (json.loads(cache.read_text()) or {}).get("pairs") or []
        except Exception:
            ranked = []
        if from_row is not None and 0 <= from_row < len(ranked):
            row = ranked[from_row]
        else:
            for r in ranked:
                if isinstance(r, dict) and r.get("coin") == symbol:
                    row = r
                    break
    if row is None:
        sys.exit(f"{symbol} not found in screen cache — run: grid/dev screen")

    ticket = _swarm_ticket(row)
    print(json.dumps({
        "symbol": symbol,
        "screen_score": row.get("score"),
        "atr_pct": row.get("atr_pct"),
        "ticket": ticket,
    }, indent=2))


def _instance_db(bot_code: str) -> "Path | None":
    """Locate the per-instance SQLite ledger. freqtrade dry-run writes to
    tradesv3.dryrun.sqlite; live (future) writes to tradesv3.sqlite. We
    accept either so the seam works against both."""
    bot_dir = FLEET / bot_code
    for name in ("tradesv3.sqlite", "tradesv3.dryrun.sqlite"):
        p = bot_dir / name
        if p.is_file():
            return p
    return None


def cmd_ledger_sync():
    """Ingest every instance's live tradesv3(.dryrun).sqlite into the M4
    reliability ledger and archive it (the cron seam that feeds the
    ladder + kill gate that engine_config reads via _ladder_pct)."""
    sys.path.insert(0, str(WS))
    from grid.reliability import ledger as m4
    argv = []
    for bot_code in effective_slots():
        db = _instance_db(bot_code)
        if db is not None:
            argv += ["--sqlite", f"{db}={LADDER_ARCHETYPE}"]
    if not argv:
        print("no tradesv3.sqlite found — run: grid/dev start first")
        return
    argv += ["--save-archive", str(STATE / "reliability_archive.json"),
             "--report"]
    sys.exit(m4._cli(argv))


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    args = argv[2:]
    if cmd == "status":
        cmd_status()
    elif cmd == "pb":
        cmd_pb(args[0] if args else None)
    elif cmd == "start":
        no_ft = "--no-ft" in args
        no_con = "--no-console" in args
        pb_start()
        if not no_con:
            console_start()
        if not no_ft:
            engine_start()
        if not no_con and no_ft:
            print("(engine skipped: --no-ft)")
    elif cmd == "stop":
        engine_stop() if "--keep-ft" not in args else print("engine kept (--keep-ft)")
        console_stop() if "--keep-console" not in args else print("console kept (--keep-console)")
        pb_stop() if "--keep-pb" not in args else print("pocketbase kept (--keep-pb)")
    elif cmd == "restart":
        engine_stop()
        console_stop()
        pb_stop()
        pb_start()
        console_start()
        engine_start()
    elif cmd == "logs":
        which = args[0] if args else "ft"
        n = int(args[1]) if len(args) > 1 else 40
        cmd_logs(which, n)
    elif cmd == "reset":
        cmd_reset("--yes" in args)
    elif cmd == "open":
        import webbrowser
        url = f"http://127.0.0.1:{CONSOLE_PORT}/#fleet"
        webbrowser.open(url)
        print(f"opened {url}")
    elif cmd == "ledger":
        for row in ledger_summary():
            print(row)
        print("refresh: python3 -m grid.reliability.ledger "
              "--sqlite <db>=<archetype> --report   (M4 CLI)")
        print("live fleet: grid/dev ledger-sync   (ingest every instance's "
              "tradesv3.dryrun.sqlite)")
    elif cmd == "ledger-sync":
        cmd_ledger_sync()
    elif cmd == "screen":
        cmd_screen(args)
    elif cmd == "rotate":
        cmd_rotate(args)
    elif cmd == "evaluate":
        cmd_evaluate(args)
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
