def _tail(path, n=20):
    try:
        lines = Path(path).read_text(errors="replace").splitlines()
        return lines[-n:]
    except Exception:
        return [f"(no log at {path})"]


def _tier(stats):
    """Display-only tier label — mirrors grid.reliability.ledger ladder
    constants (KILL_MIN_SAMPLES=10, LADDER_FULL_MIN_SAMPLES=30,
    LADDER_FULL_MIN_PF=1.3) so the displayed tier matches the gating
    logic in refuse_new_archetype / size_multiplier. With < KILL_MIN_SAMPLES
    a low recent_pf is noise, not a kill — we report 'base' there."""
    samples = stats.get("samples") or 0
    pf = stats.get("profit_factor") or 0.0
    recent = stats.get("recent_pf") or 0.0
    # Kill gate: measured AND recently unprofitable. require>=10 samples
    # so a fresh archetype can't ban itself out of the sampling loop.
    if samples >= 10 and recent < 1.0:
        return "KILLED"
    if samples >= 30 and pf >= 1.3:
        return "full"
    if samples >= 10:
        return "probe"
    return "base"


def ledger_summary():
    try:
        led = json.loads(RELIABILITY.read_text())
    except Exception:
        return ["ledger: (none yet at grid/state/reliability.json — "
                "see python3 -m grid.reliability.ledger --help)"]
    rows = ["ledger (grid/state/reliability.json):"]
    total = synth = 0
    for arch in sorted(led):
        s = led[arch] or {}
        total += s.get("samples") or 0
        synth += s.get("synthetic_samples") or 0
        rows.append(f"  {arch:34s} samples {s.get('samples', 0):>4d} "
                    f"(+{s.get('synthetic_samples', 0):<3d} synth) · "
                    f"pf {s.get('profit_factor', 0):>6.2f} · "
                    f"recent {s.get('recent_pf', 0):>6.2f} · tier {_tier(s)}")
    rows.append(f"  total {total} real samples, {synth} synthetic")
    return rows


