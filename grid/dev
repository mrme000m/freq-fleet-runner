def console_start():
    running, pid = console_running()
    if running:
        print(f"console already running (pid {pid}) on :{CONSOLE_PORT}")
        if pid:
            _pidfile_write("console", pid)
        return
    STATE.joinpath("logs").mkdir(parents=True, exist_ok=True)
    env = {**os.environ, "CONSOLE_PORT": str(CONSOLE_PORT),
           "PB_URL": PB_URL}
    log = open(CONSOLE_LOG, "ab")
    proc = subprocess.Popen([sys.executable, "console/server.py"],
                            stdout=log, stderr=subprocess.STDOUT,
                            stdin=subprocess.DEVNULL, cwd=str(GRID),
                            start_new_session=True, env=env)
    _pidfile_write("console", proc.pid)
    t0 = time.time()
    while time.time() - t0 < 15:
