def cmd_reset(yes=False):
    """Full reset: stop the whole stack, archive grid/state/ to a
    timestamped backup sibling, recreate it clean. engine.json (the
    engine declaration) and llm.env (the LLM sidecar keys) are carried
    over — they are wiring/config, not runtime state. The WT-era frozen
    archives (decisions journal, reports, reliability files) move to the
    backup: preserved on disk, gone from the console."""
    if not yes:
        print("reset is destructive — pass --yes to confirm. state/ is "
              "archived to a state.reset-<timestamp>/ sibling first, and "
              "engine.json + llm.env are carried over.")
        sys.exit(2)
    engine_stop()
    console_stop()
    pb_stop()
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    backup = GRID / f"state.reset-{stamp}"
    if STATE.exists():
        os.rename(STATE, backup)
        print(f"state archived  : {backup}")
    STATE.mkdir(parents=True, exist_ok=True)
    (STATE / "logs").mkdir(exist_ok=True)
    (STATE / "pids").mkdir(exist_ok=True)
    FLEET.mkdir(parents=True, exist_ok=True)
    carried = []
    for name in ("engine.json", "llm.env"):
        src = backup / name
        if src.is_file():
            shutil.copy2(src, STATE / name)
            carried.append(name)
    if "llm.env" in carried:
        os.chmod(STATE / "llm.env", 0o600)
    if carried:
        print(f"carried over    : {', '.join(carried)}")
    print("state is clean — start the fleet: grid/dev start")


