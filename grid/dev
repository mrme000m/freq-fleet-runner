#!/usr/bin/env python3
"""grid/dev — start and manage the STANDALONE grid system from this repo.

Usage:
  grid/dev status                     everything at a glance
  grid/dev start [--no-ft] [--no-console]
  grid/dev stop  [--keep-ft] [--keep-console] [--keep-pb]
  grid/dev restart
  grid/dev reset --yes                full reset: stop the stack, archive
                                      state/ to state.reset-<ts>/ (backup
                                      kept), recreate it clean (carries
                                      engine.json + llm.env over)
  grid/dev pb [start|stop|status]     workspace PocketBase lifecycle
  grid/dev logs [ft|console|pb|<bot>] [lines]
  grid/dev open                      open the console #fleet page in a browser
  grid/dev ledger                    reliability-ledger summary (M4)
  grid/dev ledger-sync               ingest every instance's live tradesv3.sqlite
                                     (or .dryrun.sqlite) into the ledger + archive
                                     (M4 cron seam)
  grid/dev screen [--top N]          rank Hyperliquid USDC perps by ATR%×volume
  grid/dev rotate [--top N] [--llm] [--yes]
                                     swap weak slots onto top-ranked pairs;
                                     --llm filters every candidate through the
                                     Mistral-driven swarm (grid.agents) so
                                     only GO tickets land
  grid/dev evaluate <SYM> [--from-row N]
                                     run the swarm on one screen-cache entry
                                     (no state mutation — print ticket only)

What this manages (the standalone runtime):
  pocketbase  the vendored PocketBase sidecar on 127.0.0.1:8290 (grid/.pocketbase/,
              pb_data/ journal DB) — started BEFORE the console so journal
              reads work from the first page load. Port 8290 is deliberately
              NOT the M3 stack's 8090: the two runtimes must never cross-wire.
  console   grid/console/server.py on 127.0.0.1:8798 — the mission console
            (state: grid/state/, engine banner from state/engine.json)
  engine    the dry-run freqtrade fleet — 4 slots × 150 USDC on Hyperliquid
            USDC perps (BTC / ETH / SOL / HYPE, 1m/3m/3m/5m per-slot, GridStrategy; pairs
            verified active in ccxt). Params band_atr 4.2 / step_factor 1.0
            (taker-viable baseline — M2's 0.21 was maker-modeled and must be
            re-hyperopted). alloc scales by the M4 reliability ladder
            (ladder_pct injected into each config). Instance dirs + registry
            entries live in grid/state/ft_fleet/<bot>/ using the SAME layout
            and entry schema as the M3 backend, so the console fleet row (and
            the M3 daemon, once it lands) read them natively.

What this deliberately does NOT manage:
  the autonomy brain (screen → LLM swarm → deploy). It is still M3-in-flight
  in the grid-autonomy repo; the WT-era daemon was closed 2026-09-15 (see
  state/engine.json). When M3 lands here, `dev` grows a `brain` command.

Everything here is DRY-RUN only: the instance config hardcodes
dry_run: true. Nothing in this script can place a live order.
"""
import json
import os
import secrets
import shutil
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

GRID = Path(__file__).resolve().parent          # grid/
WS = GRID.parent                                 # repo root
STATE = GRID / "state"
FLEET = STATE / "ft_fleet"
REGISTRY = FLEET / "registry.json"
PIDS = STATE / "pids"
CONSOLE_LOG = STATE / "logs" / "console.log"
ENGINE_JSON = STATE / "engine.json"
RELIABILITY = STATE / "reliability.json"

PB_PORT = 8290                                    # NOT 8090 — that belongs
                                                  # to the M3 stack in
                                                  # grid-autonomy; this
                                                  # standalone runtime must
                                                  # never collide with it
PB_DIR = GRID / ".pocketbase"                     # binary + pb.env + pb_hooks
PB_BIN = PB_DIR / "pocketbase"
PB_DATA = PB_DIR / "pb_data"
PB_HEALTH = f"http://127.0.0.1:{PB_PORT}/api/health"
PB_URL = f"http://127.0.0.1:{PB_PORT}"            # passed to the console env

CONSOLE_PORT = 8798
ENGINE_BASE_PORT = 8191                           # M3's backend allocates
                                                  # 8091+ sequentially — stay
                                                  # clear of that range so a
                                                  # concurrent M3 smoke can
                                                  # never collide with ours
# the standalone fleet: 4 slots × 150 USDC, one Hyperliquid USDC perp per
# slot (all verified active in ccxt before being listed here).
# 2026-09-15 reset: slots run in the 1-5m band per user directive —
# each slot is pinned to its own TF so a) every candle decisions are
# fast, b) the LLM screen/swarm has richer lower-TF context than the
# prior 1h setup could give, c) any one slot's noise is independent.
SLOTS = {
    "ft-btc":  ("BTC/USDC:USDC",  "BTCUSDC"),
    "ft-eth":  ("ETH/USDC:USDC",  "ETHUSDC"),
    "ft-sol":  ("SOL/USDC:USDC",  "SOLUSDC"),
    "ft-hype": ("HYPE/USDC:USDC", "HYPEUSDC"),
}
# Slot → timeframe. 1m-5m band (post-2026-09-15 reset). The TF is
# stamped into the instance config and overrides GridStrategy's default.
SLOT_TIMEFRAMES = {
    "ft-btc":  "1m",   # most liquid, fastest cycle
    "ft-eth":  "3m",
    "ft-sol":  "3m",
    "ft-hype": "5m",   # thinner book, slower to settle
}
DRY_RUN_WALLET = 150.0                           # per slot — 4 × 150 = 600

# density: one open trade per instance (multi-pair-per-instance = raise this
# AND widen the whitelist; level-multiplexed fleet stays M5 scope)
MAX_OPEN_TRADES = 1
# Hyperliquid public API throttle: each instance's ccxt rateLimit in ms, so
# the 4-slot fleet stays under the shared 429 budget (producer/consumer is
# the real fix, this is the cheap mitigation). 1000 ms × 4 slots × 4 calls
# per candle ≈ 16 req / candle — well under the HL free tier; the previous
# 500 ms × 4 × 4 = 32 req / candle caused connection-pool exhaustion
# (sqlalchemy QueuePool 5+10 hit) and wedged the engines.
CCXT_RATE_LIMIT_MS = 1000
# ladder archetype for the standalone long-grid fleet (canonical M4 label)
LADDER_ARCHETYPE = "Long Grid / classic LONG"
SLOTS_OVERRIDE = STATE / "slots.json"            # `rotate` writes pair swaps here

FT_BIN = WS / ".venv-ft" / "bin" / "freqtrade"    # load-bearing for M3 — read-only use
STRATEGY_SRC = GRID / "strategies"               # GridStrategy.py/.json + grid_geometry.py
STRATEGY_FILES = ("GridStrategy.py", "GridStrategy.json", "grid_geometry.py")

# the harness proxy is unreliable for exchange traffic (verified M3 gotcha) —
# strip every proxy variable from the engine's environment
_PROXY_VARS = ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "FTP_PROXY",
               "http_proxy", "https_proxy", "all_proxy", "ftp_proxy",
               "NO_PROXY", "no_proxy")

READY_TIMEOUT_S = 180                            # Hyperliquid startup data is slow
STOP_GRACE_S = 15


def _utcnow():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def _http_ok(url, timeout=2.0):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return r.status == 200
    except Exception:
        return False


def _port_pid(port):
    """The PID listening on `port`, via lsof (pidfiles can go stale)."""
    try:
        out = subprocess.run(["lsof", "-tiTCP:" + str(port), "-sTCP:LISTEN"],
                             capture_output=True, text=True, timeout=5).stdout
        pids = [p for p in out.split() if p.strip().isdigit()]
        return int(pids[0]) if pids else None
    except Exception:
        return None


def _pidfile_read(name):
    try:
        return int((PIDS / f"{name}.pid").read_text().strip())
    except Exception:
        return None


def _pidfile_write(name, pid):
    PIDS.mkdir(parents=True, exist_ok=True)
    (PIDS / f"{name}.pid").write_text(f"{pid}\n")


def _pidfile_clear(name):
    try:
        (PIDS / f"{name}.pid").unlink()
    except FileNotFoundError:
        pass


# ── registry (workspace copy; same schema the M3 backend uses) ───────────

def _allocate_port(reg):
    """Next free port: skips ports other registry entries claim AND ports
    with a live listener (e.g. an M3 smoke instance holding 8091+)."""
    used = {int(e.get("port") or 0)
            for e in reg["instances"].values() if isinstance(e, dict)}
    port = ENGINE_BASE_PORT
    while port in used or _port_pid(port) is not None:
        port += 1
    return port


def load_registry():
    try:
        reg = json.loads(REGISTRY.read_text())
        if isinstance(reg, dict) and isinstance(reg.get("instances"), dict):
            return reg
    except Exception:
        pass
    return {"version": 1, "instances": {}, "archived": []}


def save_registry(reg):
    REGISTRY.parent.mkdir(parents=True, exist_ok=True)
    tmp = REGISTRY.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(reg, indent=2) + "\n")
    tmp.replace(REGISTRY)


def effective_slots():
    """SLOTS with any `rotate` pair swaps applied (state/slots.json)."""
    slots = dict(SLOTS)
    try:
        over = json.loads(SLOTS_OVERRIDE.read_text())
        if isinstance(over, dict):
            for k, v in over.items():
                if isinstance(v, list) and len(v) == 2 and \
                        isinstance(v[0], str) and isinstance(v[1], str):
                    slots[k] = (v[0], v[1])
    except Exception:
        pass
    return slots


def _ladder_pct():
    """Fraction of alloc_usd to deploy, from the M4 reliability ladder for
    the long-grid archetype: base 0.25 (no evidence) → probe 0.40 → full
    0.50; 0.0 when the kill gate fires (≥10 samples & recent_pf < 1.0).
    Falls back to 1.0 (unscaled) only if the ledger module is unavailable."""
    try:
        sys.path.insert(0, str(WS))
        from grid.reliability import ledger as m4
        led = json.loads(RELIABILITY.read_text()) if RELIABILITY.is_file() \
            else {}
        if m4.refuse_new_archetype(led, LADDER_ARCHETYPE):
            return 0.0
        mult, _tier, _st = m4.size_multiplier(led, LADDER_ARCHETYPE)
        return float(mult)
    except Exception:
        return 1.0


def _ladder_tier():
    """Human-readable ladder tier for the registry entry (informational)."""
    try:
        sys.path.insert(0, str(WS))
        from grid.reliability import ledger as m4
        led = json.loads(RELIABILITY.read_text()) if RELIABILITY.is_file() \
            else {}
        if m4.refuse_new_archetype(led, LADDER_ARCHETYPE):
            return "KILLED"
        _mult, tier, _st = m4.size_multiplier(led, LADDER_ARCHETYPE)
        return tier
    except Exception:
        return "base"


def _arg_int(args, flag, default):
    if flag in args:
        i = args.index(flag)
        if i + 1 < len(args):
            try:
                return int(args[i + 1])
            except ValueError:
                pass
    return default


# ── engine (dry-run freqtrade instance) ─────────────────────────────────

def engine_config(port, username, password, pair, pair_code,
                  ladder_pct=None, timeframe=None):
    """The instance config — mirrors the verified ft_user_data/config.json
    (hyperliquid futures/isolated dry-run, backtested M1/M2 shape) plus the
    api_server + initial_state the M3 backend adds per instance. `ladder_pct`
    (M4 reliability ladder) scales the strategy's alloc; None → compute here.
    `timeframe` defaults to the slot's pinned TF (SLOT_TIMEFRAMES) but can be
    overridden — backtests/hyperopt pass it through explicitly."""
    bot_tf = timeframe or "1m"  # overwritten by materialize() w/ slot TF
    return {
        "exchange": {
            "name": "hyperliquid", "key": "", "secret": "",
            "ccxt_config": {"rateLimit": CCXT_RATE_LIMIT_MS},
            "ccxt_async_config": {"rateLimit": CCXT_RATE_LIMIT_MS},
            "pair_whitelist": [pair], "pair_blacklist": [],
        },
        "trading_mode": "futures",
        "margin_mode": "isolated",
        "dry_run": True,
        "dry_run_wallet": DRY_RUN_WALLET,
        "stake_currency": "USDC",
        "stake_amount": "unlimited",
        "timeframe": bot_tf,
        "ladder_pct": ladder_pct if ladder_pct is not None else _ladder_pct(),
        "max_open_trades": MAX_OPEN_TRADES,
        "entry_pricing": {"price_side": "same", "use_order_book": True,
                          "order_book_top": 1},
        "exit_pricing": {"price_side": "same", "use_order_book": True,
                         "order_book_top": 1},
        "unfilledtimeout": {"entry": 60, "exit": 60, "exit_timeout_count": 0,
                            "unit": "minutes"},
        "pairlists": [{"method": "StaticPairList"}],
        "strategy": "GridStrategy",
        "initial_state": "running",
        "position_adjustment_enable": True,
        "max_entry_position_adjustment": -1,
        "tradable_balance_ratio": 0.85,
        "fee": 0.001,
        "api_server": {
            "enabled": True, "listen_ip_address": "127.0.0.1",
            "listen_port": int(port), "username": username,
            "password": password, "CORS_origins": [], "verbosity": "error",
        },
    }


def materialize(bot_code):
    """Create/refresh one instance dir + registry entry (idempotent).
    Reuses an existing entry's port/credentials so a restarted instance
    keeps its trades database and console identity."""
    pair, pair_code = effective_slots()[bot_code]
    ladder = _ladder_pct()
    tier = _ladder_tier()
    bot_dir = FLEET / bot_code
    reg = load_registry()
    entry = reg["instances"].get(bot_code)

    port = username = password = None
    if entry and entry.get("username") and entry.get("password"):
        username, password = entry["username"], entry["password"]
        # engine_start() guarantees our engine is down when this runs, so a
        # live listener on the registered port is a FOREIGN process (e.g. an
        # M3 smoke instance holding 8091+) — move to a fresh port, keep creds
        if entry.get("port") and _port_pid(entry["port"]) is None:
            port = int(entry["port"])
    if port is None:
        port = _allocate_port(reg)
    if not username:
        username = secrets.token_urlsafe(8)
    if not password:
        password = secrets.token_urlsafe(12)

    bot_dir.mkdir(parents=True, exist_ok=True)
    (bot_dir / "strategies").mkdir(exist_ok=True)
    for fn in STRATEGY_FILES:
        shutil.copy2(STRATEGY_SRC / fn, bot_dir / "strategies" / fn)
    tf = SLOT_TIMEFRAMES.get(bot_code, "1m")
    with open(bot_dir / "config.json", "w") as f:
        json.dump(engine_config(port, username, password, pair, pair_code,
                                ladder_pct=ladder, timeframe=tf), f, indent=2)

    entry = {
        "bot_code": bot_code,
        "dir": str(bot_dir),
        "port": int(port),
        "username": username,
        "password": password,      # secrets live ONLY here + config.json
        "pair": pair,
        "pair_code": pair_code,
        "symbol": pair_code,
        "venue": "hyperliquid",
        "exchange_code": "HYPERLIQUID_SWAP",
        "grid_type": "long",
        "timeframe": tf,           # 2026-09-15 reset: per-slot 1-5m TF
        "slot_balance": DRY_RUN_WALLET,
        "ladder_pct": ladder,
        "ladder_tier": tier,
        "channel": {
            "low": None, "mid": None, "high": None,
            "step_pct": None, "atr_pct": None,
            "grids": None,
            "note": "channel computed at runtime by GridStrategy "
                     "(tuned params band_atr 4.2, step_factor 1.0 taker-viable)",
        },
        "created_at": entry.get("created_at") if entry else _utcnow(),
        "pid": None,
        "status": "created",
        "backend": "freqtrade-dry-run",
        "spawned_by": "grid/dev",
    }
    reg["instances"][bot_code] = entry
    save_registry(reg)
    return entry


def _is_ours(pid, bot_dir=None):
    """A listener pid is our engine only if it's a freqtrade process under
    OUR userdir — never adopt a concurrent M3 smoke instance."""
    try:
        out = subprocess.run(["ps", "-o", "command=", "-p", str(pid)],
                             capture_output=True, text=True, timeout=5).stdout
        return "freqtrade" in out and str(bot_dir or FLEET) in out
    except Exception:
        return False


def engine_running(entry=None):
    """(running, pid) for ONE registry entry; (False, None) when the
    entry is absent — the fleet loop materializes missing bots itself,
    so a missing entry must never fall back to another slot's state."""
    if not isinstance(entry, dict):
        return False, None
    pid = entry.get("pid") or _pidfile_read(entry.get("bot_code"))
    if pid and _alive(pid):
        return True, int(pid)
    p = _port_pid(entry.get("port"))
    if p and _is_ours(p, entry.get("dir")):
        return True, p
    return False, None


def engine_start():
    if not FT_BIN.is_file():
        sys.exit(f"missing freqtrade binary: {FT_BIN} (.venv-ft is "
                 "path-load-bearing for M3 — do not move/rename)")
    for fn in STRATEGY_FILES:
        if not (STRATEGY_SRC / fn).is_file():
            sys.exit(f"missing strategy file: {STRATEGY_SRC / fn}")

    env = {k: v for k, v in os.environ.items() if k not in _PROXY_VARS}
    env["PYTHONUNBUFFERED"] = "1"
    spawned = []
    for bot_code in effective_slots():
        running, pid = engine_running(
            load_registry()["instances"].get(bot_code))
        if running:
            print(f"engine {bot_code} already running (pid {pid})")
            continue
        entry = materialize(bot_code)
        port = int(entry["port"])
        if _port_pid(port):
            print(f"NOTICE: port {port} in use but no live {bot_code} — "
                  f"skipping (investigate: lsof -iTCP:{port})")
            continue
        bot_dir = FLEET / bot_code
        log = open(bot_dir / "freqtrade.log", "ab")
        proc = subprocess.Popen(
            [str(FT_BIN), "trade", "--dry-run", "--userdir", str(bot_dir),
             "--config", str(bot_dir / "config.json")],
            stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
            start_new_session=True, env=env, cwd=str(bot_dir))
        _pidfile_write(bot_code, proc.pid)
        reg = load_registry()
        if bot_code in reg["instances"]:
            reg["instances"][bot_code]["pid"] = proc.pid
            reg["instances"][bot_code]["status"] = "starting"
            save_registry(reg)
        print(f"engine {bot_code} starting (pid {proc.pid}, port {port}, "
              f"{entry['pair']} {SLOT_TIMEFRAMES.get(bot_code, '1m')} DRY-RUN · "
              f"wallet {DRY_RUN_WALLET}, Hyperliquid)")
        spawned.append((bot_code, bot_dir, proc, port))
        # stagger spawns so the 4-slot fleet doesn't burst the shared
        # Hyperliquid rate budget at startup (see CCXT_RATE_LIMIT_MS).
        # 10 s × 4 instances = 40 s total startup ramp; gives each
        # engine time to finish its first get_tickers() + OHLCV warm
        # before the next instance joins. Without this the public
        # HL /info endpoint returns 429 for the whole fleet and the
        # engines wedge on the connection pool.
        time.sleep(10)
    if not spawned:
        return
    # wait for every spawned engine's /ping in parallel — Hyperliquid
    # startup data is slow and 4 sequential waits would take 4× as long
    t0 = time.time()
    pending = list(spawned)
    while pending and time.time() - t0 < READY_TIMEOUT_S:
        for item in pending[:]:
            bot_code, bot_dir, proc, port = item
            if not _alive(proc.pid):
                print(f"engine {bot_code} DIED during startup. Last log "
                      "lines:")
                for line in _tail(bot_dir / "freqtrade.log", 5):
                    print("  " + line)
                pending.remove(item)
                continue
            if _http_ok(f"http://127.0.0.1:{port}/api/v1/ping", timeout=2):
                reg = load_registry()
                if bot_code in reg["instances"]:
                    reg["instances"][bot_code]["status"] = "running"
                    save_registry(reg)
                print(f"engine {bot_code} READY "
                      f"({int(time.time() - t0)}s) — API "
                      f"http://127.0.0.1:{port}/ · dry-run paper only")
                pending.remove(item)
        if pending:
            time.sleep(2)
    for bot_code, bot_dir, *_ in pending:
        print(f"engine {bot_code} not ready after {READY_TIMEOUT_S}s — it "
              f"may still be loading market data; check: "
              f"grid/dev logs {bot_code}")


def _terminate(pid, grace_s=STOP_GRACE_S):
    if not _alive(pid):
        return True
    try:
        os.kill(int(pid), signal.SIGTERM)
    except OSError:
        return True
    t0 = time.time()
    while _alive(pid) and time.time() - t0 < grace_s:
        time.sleep(0.5)
    if _alive(pid):
        try:
            os.kill(int(pid), signal.SIGKILL)
        except OSError:
            pass
        time.sleep(1)
    return not _alive(pid)


def engine_stop():
    reg = load_registry()
    stopped = 0
    for bot_code, entry in sorted(reg["instances"].items()):
        if not isinstance(entry, dict):
            continue
        running, pid = engine_running(entry)
        if not running:
            print(f"engine {bot_code} already stopped")
        else:
            ok = _terminate(pid)
            stopped += 1
            print(f"engine {bot_code} {'stopped' if ok else 'FAILED to stop'} "
                  f"(was pid {pid})")
        entry["pid"] = None
        entry["status"] = "stopped"
        _pidfile_clear(bot_code)
    save_registry(reg)
    if not stopped and not reg["instances"]:
        print("no fleet instances registered")


# ── pocketbase (vendored workspace sidecar, 127.0.0.1:8290) ─────────────

def _pb_is_ours(pid):
    """A listener on :8290 is our PocketBase only if its command runs the
    .pocketbase binary under THIS grid/ — same philosophy as _is_ours. A
    foreign listener (e.g. the M3 stack) is reported and left alone."""
    try:
        out = subprocess.run(["ps", "-o", "command=", "-p", str(pid)],
                             capture_output=True, text=True, timeout=5).stdout
        return str(PB_DIR) in out and "pocketbase" in out
    except Exception:
        return False


def pb_running():
    """(up, pid, ours) for the workspace PocketBase on :8290."""
    pid = _pidfile_read("pb")
    if pid and _alive(pid) and _pb_is_ours(pid):
        return _http_ok(PB_HEALTH, timeout=2), int(pid), True
    port_pid = _port_pid(PB_PORT)
    if port_pid:
        return (_http_ok(PB_HEALTH, timeout=2), port_pid,
                _pb_is_ours(port_pid))
    if _http_ok(PB_HEALTH, timeout=2):     # lsof blind spot — assume ours
        return True, None, True
    return False, None, True


def pb_start():
    up, pid, ours = pb_running()
    if up and ours:
        print(f"pocketbase already running (pid {pid}) on :{PB_PORT}")
        if pid:
            _pidfile_write("pb", pid)
        return
    if up and not ours:
        print(f"NOTICE: port {PB_PORT} is held by a FOREIGN process "
              f"(pid {pid}) — leaving it alone; pocketbase NOT started")
        return
    if not PB_BIN.is_file():
        sys.exit(f"missing pocketbase binary: {PB_BIN}")
    if not PB_DATA.is_dir():
        sys.exit(f"missing pocketbase data dir: {PB_DATA}")
    STATE.joinpath("logs").mkdir(parents=True, exist_ok=True)
    env = {k: v for k, v in os.environ.items() if k not in _PROXY_VARS}
    log = open(STATE / "logs" / "pb.log", "ab")
    proc = subprocess.Popen(
        [str(PB_BIN), "serve", "--dir", str(PB_DATA), "--http",
         f"127.0.0.1:{PB_PORT}"],
        stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
        start_new_session=True, env=env, cwd=str(PB_DIR))
    _pidfile_write("pb", proc.pid)
    print(f"pocketbase starting (pid {proc.pid}) on :{PB_PORT} — waiting "
          f"for /api/health …")
    t0 = time.time()
    while time.time() - t0 < 15:
        if not _alive(proc.pid):
            tail = _tail(STATE / "logs" / "pb.log", 5)
            sys.exit("pocketbase died during startup. Last log lines:\n  " +
                     "\n  ".join(tail))
        if _http_ok(PB_HEALTH, timeout=2):
            print(f"pocketbase READY ({int(time.time() - t0)}s) — "
                  f"{PB_URL}")
            return
        time.sleep(0.5)
    print(f"pocketbase not ready after 15s — check: grid/dev logs pb")


def pb_stop():
    up, pid, ours = pb_running()
    if up and not ours:
        print(f"NOTICE: port {PB_PORT} is held by a FOREIGN process "
              f"(pid {pid}) — leaving it alone")
        return
    if not (pid and _alive(pid)):
        print("pocketbase already stopped")
        _pidfile_clear("pb")
        return
    ok = _terminate(pid)
    print(f"pocketbase {'stopped' if ok else 'FAILED to stop'} "
          f"(was pid {pid})")
    _pidfile_clear("pb")


def cmd_pb(arg=None):
    arg = (arg or "start").lower()
    if arg.startswith("stop"):
        pb_stop()
    elif arg.startswith("status"):
        up, pid, ours = pb_running()
        if up and ours:
