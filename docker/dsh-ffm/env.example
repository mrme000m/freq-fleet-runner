# dsh-ffm env file — copied to /opt/dsh-ffm/.env on the deploy host by the
# dsh-ffm-deploy workflow (chmod 600). Values are GitHub repo secrets; the
# file stays on the host for container restarts.

# ── Bitwarden vault machine-auth (OPTIONAL — vault_loader runs fail-soft
#    without it; the container then relies on inline env). The fleet manager
#    loads ONLY the Cloudflare items + LLM provider keys (BW_VAULT_ONLY=cf,llm):
#      opencode-cloudflare → CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_KEY
#      cloudflare-tunnels (folder cloudflare) → CF_ACCOUNT_ID + CF_API_TOKEN_READ/WRITE
#      provider-keys → NVIDIA_API_KEY / OPENROUTER_API_KEY / MISTRAL_API_KEY
BW_URL=https://keys.00m.indevs.in
BW_USERNAME=
BW_PASSWORD=
BW_CLIENTID=
BW_CLIENTSECRET=

# ── Cloudflare tunnel connector token (OPTIONAL) — when set, ffm-run.sh
#    starts the `dsh-ffm-cloudflared` connector container on the ffm-net
#    docker network, publishing http://dsh-ffm:3081 to the world via the
#    tunnel (the deploy workflow's Cloudflare-API step reconciles the ingress
#    rule for dsh-ffm.00m.indevs.in + the DNS CNAME).
CF_TUNNEL_TOKEN=

# ── Inline CF env (OPTIONAL fallback when the vault is not configured) ─────
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_KEY=

# ── Deploy-time host bootstrap (used by ffm-run.sh on the host) ────────────
# SSH key material for the ft_deploy_ssh / ft_bootstrap_host flows is NOT
# written here — those secrets live in the container's `credentials` service
# via `ft_secret_set` (kinds: ssh_key, ssh_key_passphrase).