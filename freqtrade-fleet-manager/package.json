{
  "name": "freqtrade-fleet-manager",
  "version": "0.1.0",
  "description": "Deploy, manage, and configure multiple Freqtrade instances (local and remote SSH) from a DeepSeek Harness (dsh) agent: instance registry, a 54-tool REST/CLI control surface, credential-backed secrets, config validation/generation, local + SSH deploy/sync/bootstrap, backtest/hyperopt/download jobs, producer/consumer topology, and a Settings dashboard.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "verify": "npm run build && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "freqtrade",
    "trading",
    "crypto",
    "dsh-plugin",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7 || 0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.7 || 0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7 || 0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.0-rc.7 || 0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.7 || 0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7 || 0.1.1-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}